# Copy to .env and fill in your values. Secrets never committed.

# --- Deal threshold -------------------------------------------------------
# A part is only a "deal" when priced >= MIN_DISCOUNT % below the market
# average of its search batch.
MIN_DISCOUNT=15

# --- Affiliate monetisation (optional until approved; links degrade to the
# --- plain product URL when these are empty) -----------------------------
# eBay Partner Network: the campaign id from your EPN approval email.
EPN_CAMPAIGN_ID=
# EPN network id (same for everyone, override only if asked to).
EPN_NETWORK_ID=711-53200-19255-0
# Autodoc partner programme: deep-link template containing {url}
# (e.g. https://click.example.com/click?a=1&url={url})
AUTODOC_AFFILIATE_URL=

# --- eBay Buy API (for eBay scraping) ------------------------------------
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# --- LLM title cleaning (optional; falls back to local heuristics) -------
GEMINI_API_KEY=

# --- Telegram distribution ------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ADMIN_CHAT_ID=

# --- Misc -----------------------------------------------------------------
# Show the Autodoc browser window while live-searching (debug only).
AUTODOC_WINDOW_VISIBLE=0
# Override the SQLite path (used by deployments).
# SQLALCHEMY_DATABASE_URL=sqlite:///./deals.db